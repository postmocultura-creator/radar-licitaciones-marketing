# Ficheros de depuración sueltos (ver auditoría en README: ya se borró uno).
data/_tmp_*

.vercel
.env*

# Evidencia de la referencia de diseño (capturas de un producto de terceros).
references/

# Cachés de los scrapers entre ejecuciones (en CI las conserva actions/cache).
data/cache/
