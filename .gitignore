*.pyc
.venv/

# Crudo de los scrapers: se regenera en cada ejecución (local o en CI), no
# tiene sentido versionarlo (367 MB acumulados localmente a día de hoy).
data/raw/

# Artefacto intermedio de clasificar.py, se regenera en cada ejecución.
