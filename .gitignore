__pycache__/
*.pyc
.venv/

# Crudo de los scrapers: se regenera en cada ejecución (local o en CI), no
# tiene sentido versionarlo (367 MB acumulados localmente a día de hoy).
data/raw/

# Artefactos intermedios de clasificar.py, se regeneran en cada ejecución.
data/clasificado.json
data/filtro.json

# Ficheros de depuración sueltos (ver auditoría en README: ya se borró uno).
data/_tmp_*

.vercel
.env*

# Evidencia de la referencia de diseño (capturas de un producto de terceros).
references/

# Cachés de los scrapers entre ejecuciones (en CI las conserva actions/cache).
data/cache/

# Datos internos del pipeline: viven en la rama "estado" (ver README, "Datos").
data/historico_adjudicaciones.json
data/ultimo_bueno_por_fuente.json
data/primera_aparicion.json
data/placsp_web_acumulado.json
data/euskadi_menores_acumulado.json
data/euskadi_licitadoras.json
data/alertas_enviadas.json
# Vista previa del correo (python alertas.py --prueba).
data/alerta_prueba.html
# Lo mismo que dashboard/tenders-data.js, que es lo que se publica.
data/tenders.json
